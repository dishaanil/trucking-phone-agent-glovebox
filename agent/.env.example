# Copy to .env and fill in. Never commit .env. Run with: uv run --env-file .env ...

# Glovebox API (same SERVICE_TOKEN as api/.env)
API_URL=http://localhost:3001
SERVICE_TOKEN=change-me

# LiveKit Cloud project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech and language providers
DEEPGRAM_API_KEY=
# Gemini API key (Google AI Studio), not Vertex
GOOGLE_API_KEY=
CARTESIA_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.5-flash
# TTS_PROVIDER=deepgram   # deepgram in development, cartesia for recording
