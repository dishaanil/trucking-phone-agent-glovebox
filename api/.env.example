# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://localhost:5432/glovebox
TEST_DATABASE_URL=postgresql://localhost:5432/glovebox_test
PORT=3001
# Shared secret the agent sends as "Authorization: Bearer <token>" on agent-only endpoints.
SERVICE_TOKEN=change-me
# External systems: only mock implementations exist.
INTEGRATIONS=mock
# Direct (non-pooled) Postgres URL for the SSE listener. Defaults to DATABASE_URL.
# DIRECT_DATABASE_URL=postgresql://localhost:5432/glovebox
# SSE_HEARTBEAT_MS=20000
